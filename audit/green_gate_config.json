  "rules": [
    "1. frozen refs correct and pinned",
    "2. axiom declarations = 0",
    "3. sorry proof terms = 0",
    "4. admit proof terms = 0",
    "5. opaque declarations = 0",
    "6. no forbidden administrative frontier aliases",
    "7. dedicated NewMath producer module exists",
    "8. producer is a genuine construction, not an alias/re-export/abbrev of the frontier",
    "9. material_producer_closes_frontier proves the real frontier from the concrete producer",
    "10. terminal_endpoint_certified consumes the frontier closure and proves the actual endpoint",
    "11. ArchitectureAudit.lean and lake build MCore pass",
    "12. manifest records exact producer/frontier/terminal provenance before manual green=true promotion"
  ],
  "current_state": {
    "P01-P06": {
      "GREEN": false,
      "BUILD": "UNVERIFIED",
      "reason": "RED remains correct: no lane currently has the required genuine NewMath producer -> frontier -> terminal certified chain."
    }
  },
  "promotion_contract": {
    "telemetry_field": "terminal_endpoint_closed",
    "telemetry_is_not_proof": true,
    "required_positive_theorem": "terminal_endpoint_certified",
    "theorem_requirement": "must be a theorem with no axiom/sorry/admit/opaque in its dependency tree and must consume the real frontier rather than an alias",
    "automatic_promotion": false
  },
  "material_producer_policy": {
    "alias_is_not_construction": true,
    "reject_patterns": [
      "axiom producer : Frontier",
      "opaque producer : Frontier",
      "def producer : Frontier := by sorry",
      "def producer : Frontier := existingOpenFrontier",
      "abbrev producer := Frontier"
    ],
    "require": [
      "dedicated NewMath construction module",
      "concrete producer object/theorem with axiom=0 sorry=0 admit=0 opaque=0",
      "material_producer_closes_frontier theorem proving the real frontier from the producer",
      "terminal_endpoint_certified theorem consuming that frontier closure"
    ]
  }
